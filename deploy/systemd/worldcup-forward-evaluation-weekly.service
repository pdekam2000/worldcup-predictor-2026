[Unit]
Description=WorldCup Forward Evaluation Weekly Report (DISABLED)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/worldcup-predictor
Environment=PYTHONPATH=/opt/worldcup-predictor
ExecStart=/opt/worldcup-predictor/.venv/bin/python scripts/generate_weekly_forward_evaluation_report.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
