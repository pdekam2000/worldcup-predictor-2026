[Unit]
Description=WorldCup Forward Evaluation Daily Timer (DISABLED)
Requires=worldcup-forward-evaluation-daily.service

[Timer]
OnCalendar=*-*-* 07:00:00
Timezone=Europe/Vienna
Persistent=false
# TIMERS_ENABLED = NO — do not enable this unit in production during this phase

[Install]
WantedBy=timers.target
