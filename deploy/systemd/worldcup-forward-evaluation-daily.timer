[Unit]
Description=WorldCup Forward Evaluation Automation Timer
Requires=worldcup-forward-evaluation-daily.service

[Timer]
# 07:00 and 17:00 Europe/Vienna — discovery, prematch freeze, result sync, evaluation
OnCalendar=*-*-* 07,17:00:00
Timezone=Europe/Vienna
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
