[Unit]
Description=WorldCup Forward Evaluation Automation Cycle (Tier A + Tier B)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/worldcup-predictor
Environment=PYTHONPATH=/opt/worldcup-predictor
ExecStart=/opt/worldcup-predictor/.venv/bin/python scripts/run_forward_evaluation_automation_cycle.py
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
