# Highest-priority daily prediction lifecycle — ~06:00 Europe/Vienna (04:00 UTC).
# Enabled in production via scripts/_prod_daily_pipeline_activate.sh

[Unit]
Description=WorldCup daily prediction pipeline timer (highest priority)

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=300
Unit=worldcup-prediction-daily.service

[Install]
WantedBy=timers.target
