# Highest-priority daily production prediction pipeline
# (discover → eligibility → predict → freeze → reports via run_daily_pipeline).
#
# Rollback:
#   sudo systemctl disable --now worldcup-prediction-daily.timer

[Unit]
Description=WorldCup production daily prediction pipeline (highest priority)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/worldcup-predictor
EnvironmentFile=/opt/worldcup-predictor/.env.production
Environment=APP_ENV=production
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/worldcup-predictor/.venv/bin/python scripts/run_production_prediction_pipeline.py --mode daily --timezone Europe/Vienna
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worldcup-prediction-daily

[Install]
WantedBy=multi-user.target
