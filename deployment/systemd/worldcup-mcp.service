[Unit]
Description=WorldCup Predictor MCP Server (owner AI bridge)
After=network.target worldcup-api.service
Wants=worldcup-api.service

[Service]
Type=simple
User=worldcup-mcp
Group=worldcup-mcp
WorkingDirectory=/opt/worldcup-predictor
EnvironmentFile=/opt/worldcup-predictor/.env.production
Environment=PYTHONUNBUFFERED=1
Environment=APP_ENV=production
Environment=MCP_TRANSPORT=streamable-http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8765
Environment=MCP_CALLER_MODE=systemd
Environment=MCP_AUDIT_LOG_PATH=/var/log/worldcup-mcp/audit.jsonl
ExecStart=/opt/worldcup-predictor/.venv/bin/python -m worldcup_predictor.mcp_server.server --transport streamable-http
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worldcup-mcp

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/worldcup-mcp /opt/worldcup-predictor/data /opt/worldcup-predictor/artifacts /opt/worldcup-predictor/reports

[Install]
WantedBy=multi-user.target
