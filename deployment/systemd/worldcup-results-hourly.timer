# Hourly result sync + evaluation — part of daily prediction lifecycle.
# Enabled in production via scripts/_prod_daily_pipeline_activate.sh

[Unit]
Description=WorldCup hourly results pipeline timer

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=120
Unit=worldcup-results-hourly.service

[Install]
WantedBy=timers.target
