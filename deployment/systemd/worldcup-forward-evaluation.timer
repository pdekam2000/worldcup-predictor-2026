# Forward evaluation timer — every 30 minutes (freeze result sync + market eval).
# Enabled with daily pipeline activation.

[Unit]
Description=WorldCup forward evaluation timer (every 30 minutes)

[Timer]
OnCalendar=*-*-* *:00,30:00
Persistent=true
RandomizedDelaySec=120
Unit=worldcup-forward-evaluation.service

[Install]
WantedBy=timers.target
